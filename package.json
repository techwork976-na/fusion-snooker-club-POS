{
  "name": "fusion-pos",
  "productName": "FUSION",
  "version": "1.0.0",
  "description": "FUSION Gaming Lounge — club management and point of sale (web app)",
  "author": "FUSION Gaming Lounge",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "vite build --config vite.web.config.ts",
    "preview": "vite preview --config vite.web.config.ts",
    "dev:desktop": "electron-vite dev",
    "build:desktop": "electron-vite build",
    "preview:desktop": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "setup:admin": "node scripts/create-admin.mjs",
    "reset:password": "node scripts/create-admin.mjs --reset-password",
    "dist:win": "npm run typecheck && npm run build:desktop && electron-builder --win --x64",
    "dist:dir": "npm run build:desktop && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "framer-motion": "^14.9.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
