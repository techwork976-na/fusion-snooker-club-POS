# FUSION web app — local development settings.
#
# Copy this file to `.env` (which is git-ignored) and fill in your project's
# values from Supabase → Project Settings → API. On Vercel, set the same two
# variables under Project → Settings → Environment Variables instead.
#
# Only the PUBLIC project URL and the publishable (anon) key belong here. They
# are visible to anyone who opens the web app — Row Level Security protects
# the data. NEVER put the secret / service-role key in this file: the build
# refuses secret keys, but keep them out of the project entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
