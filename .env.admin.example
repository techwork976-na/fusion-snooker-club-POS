# Used ONLY by `npm run setup:admin` and `npm run reset:password`, run on the
# owner's own computer. Copy to `.env.admin` (git-ignored), fill in, run the
# script, then DELETE `.env.admin`. Never commit it, never put it on Vercel and
# never copy it to a club computer.
#
# The secret key is under Supabase → Project Settings → API Keys (secret key,
# "sb_secret_…", or the legacy service_role key).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
